{
  "name": "dsh-whale-song",
  "version": "0.6.3",
  "description": "鲸歌桌面伙伴：程序代码开放，正式角色资产不随仓库提供",
  "keywords": [
    "desktop-pet",
    "whalesong",
    "dsh",
    "桌宠"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "desktop/standalone",
    "standalone",
    "sources",
    "skill",
    "tools",
    "LICENSE",
    "NOTICE.md",
    "ASSET_POLICY.md",
    "assets/desktop-renderer.js",
    "assets/media-bridge.js",
    "assets/media-local.js",
    "assets/media-smtc.js",
    "assets/pet.js",
    "assets/songm-renderer-old.js",
    "assets/songm-renderer.js",
    "assets/demo-whale.svg",
    "assets/vendor"
  ],
  "bin": {
    "dsh-pet": "tools/pet-ctl.mjs"
  },
  "scripts": {
    "build:model": "node tools/build-model.mjs",
    "preview": "node tools/preview-server.mjs",
    "test": "node tools/test-host.mjs",
    "test:all": "node tools/test-all.mjs",
    "test:all:live": "node tools/test-all.mjs --live",
    "test:media": "node tools/test-media-route.mjs",
    "test:media:live": "node tools/test-media-route.mjs --live",
    "test:smtc": "node tools/test-media-smtc.mjs",
    "test:music-pane": "node tools/test-music-pane.mjs",
    "test:shell": "node tools/test-shell-window.mjs",
    "standalone": "node tools/serve-standalone.mjs",
    "desktop:install": "pnpm install",
    "desktop:start": "node tools/start-next.mjs",
    "desktop:generate": "node tools/shell-gen/make-shell-cjs-server.mjs && node tools/shell-gen/make-standalone-shell.mjs",
    "desktop:dist": "electron-builder --win --x64 --publish never",
    "smoke": "node tools/smoke.mjs",
    "shot": "node tools/shot.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "test:agent": "node tools/e2e-agent.mjs",
    "ascii": "node tools/ascii.mjs",
    "test:e2e:ui": "node tools/ui-probe.mjs",
    "test:catalog": "node tools/catalog-test.mjs",
    "repro:stuck": "node tools/repro-stuck.mjs",
    "release:check": "node tools/publish.mjs --check",
    "release:github": "node tools/publish.mjs",
    "release:npm": "node tools/publish-npm.mjs",
    "release:npm:check": "node tools/publish-npm.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Andersen216",
    "url": "https://github.com/Andersen216"
  },
  "contributors": [
    {
      "name": "上善无形",
      "url": "https://space.bilibili.com/4456176",
      "role": "鲸鱼娘角色形象原作「溟月」"
    },
    {
      "name": "ZipZipPipe",
      "url": "https://space.bilibili.com/4168597",
      "role": "女仆鲸鱼娘二次设计"
    },
    {
      "name": "氵六青",
      "url": "https://space.bilibili.com/11272072",
      "role": "Live2D 模型制作（绑定/动作/表情）"
    },
    {
      "name": "H-Canopy",
      "url": "https://github.com/H-Canopy",
      "role": "增强版 fork：本地音乐 / 在线电台 / 网易云联动集成（本项目增量）"
    }
  ],
  "homepage": "https://github.com/H-Canopy/dsh-whale-song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H-Canopy/dsh-whale-song.git"
  },
  "bugs": {
    "url": "https://github.com/H-Canopy/dsh-whale-song/issues"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "private": true
}