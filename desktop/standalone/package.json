{
  "name": "dsh-whale-song-standalone",
  "productName": "DS-WhaleSong-Pet",
  "version": "0.1.0",
  "description": "鲸歌 · 独立桌宠壳：把 DS 鲸鱼娘放到桌面上（透明、置顶、点击穿透、贴边小球），**不需要 DSH 在运行**。她本体是同一套前端（assets/），音乐联动走 Windows 媒体会话（SMTC）。搭配 DSH 才是完整版（跟着 agent 干活 / 工作简报 / 钱包 / 点歌）。",
  "main": "main.js",
  "author": "H-Canopy",
  "contributors": [
    {
      "name": "Andersen216",
      "url": "https://github.com/Andersen216",
      "role": "上游桌宠与 Windows 壳（MIT）"
    }
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hcanopy.dsh.whalesongpet",
    "productName": "DS-WhaleSong-Pet",
    "files": [
      "main.js",
      "server.cjs",
      "media-bridge.cjs",
      "preload.js",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../assets",
        "to": "dsh-whale-song/assets"
      },
      {
        "from": "../../standalone",
        "to": "dsh-whale-song/standalone"
      },
      {
        "from": "../../lib",
        "to": "dsh-whale-song/lib"
      },
      {
        "from": "../../desktop/standalone/ui",
        "to": "dsh-whale-song/desktop/standalone/ui"
      },
      {
        "from": "../../AUTHORS.md",
        "to": "dsh-whale-song/AUTHORS.md"
      },
      {
        "from": "../../NOTICE.md",
        "to": "dsh-whale-song/NOTICE.md"
      },
      {
        "from": "../../LICENSE",
        "to": "dsh-whale-song/LICENSE"
      }
    ],
    "win": {
      "icon": "../windows/build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DS 鲸歌桌宠"
    },
    "artifactName": "DS-WhaleSong-Pet-Windows-Setup.${ext}"
  }
}
